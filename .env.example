DISCORD_TOKEN=seu_token_aqui
CLIENT_ID=id_do_seu_bot
GUILD_ID=id_do_seu_servidor

# Nome exato do cargo que pode criar/deletar tags de rolagem
MASTER_ROLE=Mestre

# ── Banco de dados ─────────────────────────────────────────────
# Defina USE_LOCAL_DATA=true para usar os JSONs em data/ (teste local)
# Defina USE_LOCAL_DATA=false (ou omita) para usar o MongoDB Atlas
USE_LOCAL_DATA=true

# MongoDB Atlas — necessário apenas quando USE_LOCAL_DATA=false
# Formato: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/
