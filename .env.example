# ============================================================
#  Chaos RPG Bot — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores.
#  No Railway, configure estas variáveis em:
#  Settings → Variables (não use arquivo .env no deploy)
# ============================================================

# ── Discord ───────────────────────────────────────────────────
# Token do bot (Discord Developer Portal → Bot → Token)
DISCORD_TOKEN=

# Application ID do bot (Discord Developer Portal → General Information)
CLIENT_ID=

# ID do servidor para registro de comandos em dev (deixe vazio em produção)
# Com GUILD_ID: comandos aparecem instantaneamente no servidor especificado
# Sem GUILD_ID: comandos são registrados globalmente (leva até 1h na primeira vez)
GUILD_ID=

# ── Banco de dados ────────────────────────────────────────────
# URI de conexão do MongoDB Atlas
# Formato: mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_URI=

# Usar arquivos JSON locais ao invés do MongoDB (apenas para dev local)
# true  → usa data/*.json (não precisa de MONGODB_URI)
# false → usa MongoDB Atlas (necessário para Railway/produção)
USE_LOCAL_DATA=false

# ── Spotify ───────────────────────────────────────────────────
# Credenciais do app Spotify (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# URI de redirecionamento OAuth (deve estar cadastrada no app Spotify)
SPOTIFY_REDIRECT_URI=https://exceededits.github.io/chaos-rpg-site/spotify-callback.html

# Token de atualização do Spotify (obtido via: node scripts/spotify-auth.js)
# Necessário para acessar playlists privadas do usuário
SPOTIFY_REFRESH_TOKEN=

# ── Permissões ────────────────────────────────────────────────
# Nome do cargo de Mestre (fallback por nome se /config cargo-mestre não foi usado)
# Use /config cargo-mestre no servidor para configurar por ID (mais confiável)
MASTER_ROLE=Mestre
